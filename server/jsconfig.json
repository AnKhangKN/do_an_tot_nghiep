{
  "compilerOptions": {
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["./src/*"],
      "@config/*": ["./src/config/*"],
      "@middlewares/*": ["./src/middlewares/*"],
      "@modules/*": ["./src/modules/*"],
      "@routes/*": ["./src/routes/*"],
      "@utils/*": ["./src/utils/*"],
      "@events/*": ["./src/events/*"],
      "@socket/*": ["./src/socket/*"]
    }
  },
  "include": ["src/**/*"]
}