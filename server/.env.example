PORT=8080
FRONTEND_URL=http://localhost:5173

# DATABASE (Postgres)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=123456
DB_NAME=mydb
DB_SSL=false

# REDIS
# Ưu tiên REDIS_URL (nếu có). Railway public: rediss://default:pass@<tcp-proxy>:<port>
# hoặc redis://default:pass@<tcp-proxy>:<port>; local dạng redis://127.0.0.1:6379
REDIS_URL=
# Các biến dưới dùng khi không có REDIS_URL
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# JWT
JWT_ACCESS_TOKEN=
JWT_REFRESH_TOKEN=

# COOKIE
COOKIE_SECURE=false
# none (cross-site) khi COOKIE_SECURE=true trên HTTPS; lax khi chạy local
COOKIE_SAMESITE=lax

# CLOUDINARY
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# MAILVERIFY
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# MAIL DRIVER: smtp | log | brevo
MAIL_DRIVER=smtp
MAIL_FROM=

# BREVO (dùng khi MAIL_DRIVER=brevo)
BREVO_API_KEY=

# FIREBASE (dán JSON service-account.json 1 dòng; local sẽ tự đọc file service-account.json)
FIREBASE_SERVICE_ACCOUNT=

# GROQ AI
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.1-70b-versatile
